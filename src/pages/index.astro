---
import Layout from '../layouts/Layout.astro';
import { PROVIDER_COUNT, PROVIDERS } from '../lib/providers';
import { getRates } from '../lib/rates';
import { resolveObservedRates } from '../lib/observedRates';
import { simulate } from '../lib/remittanceCalculator';
import {
  DEFAULT_AMOUNT_JPY,
  DEFAULT_CURRENCY,
  MIN_AMOUNT_JPY,
  MAX_AMOUNT_JPY,
} from '../lib/simulationRequest';
import { renderRateLine, renderResultsMeta, renderResultsTable } from '../lib/renderResults';

export const prerender = false;

// --- Server-rendered first paint ---------------------------------------------
// The default comparison (¥100,000 → IDR) is computed here and rendered as a
// REAL table (works without JS). Both the mid-market table and the observed
// per-provider rates go through their read-through KV resolvers: a warm
// request is instant; a cold one (12 h cache expired) fetches the due rate
// adapters in parallel under an ~10 s overall budget and renders partial
// results — failures fall back to estimated rows, the page always renders.
const kv = Astro.locals?.runtime?.env?.RATES_KV;
const rates = await getRates(kv);
const corridorProviderIds = PROVIDERS.filter((p) =>
  p.supportedCurrencies.includes(DEFAULT_CURRENCY),
).map((p) => p.id);
const { byProvider } = await resolveObservedRates(corridorProviderIds, kv, {
  midMarketRates: rates.rates,
});
const initial = simulate(
  { amountJPY: DEFAULT_AMOUNT_JPY, targetCurrency: DEFAULT_CURRENCY, deliveryType: 'all' },
  rates,
  byProvider,
);

// Data handed to the client controller (re-runs via /api/simulate on Compare).
const bootstrap = {
  initial,
  defaults: {
    amountJPY: DEFAULT_AMOUNT_JPY,
    min: MIN_AMOUNT_JPY,
    max: MAX_AMOUNT_JPY,
  },
};

const rateLineHtml = renderRateLine(initial);
const resultsMetaHtml = renderResultsMeta(initial);
---

<Layout>
  <div class="mx-auto max-w-6xl px-4 pb-24 pt-6 sm:px-6">
    <!-- Header -->
    <header class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="grid h-10 w-10 place-items-center rounded-xl bg-indigo-600 text-lg font-bold text-white shadow-sm">
          ¥→
        </div>
        <div>
          <h1 class="text-base font-semibold leading-tight sm:text-lg">JP Remittance Simulator</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Comparing {PROVIDER_COUNT} services sending money from Japan to Indonesia (IDR)
          </p>
        </div>
      </div>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <!-- sun (shown in dark mode) -->
        <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <!-- moon (shown in light mode) -->
        <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </header>

    <!-- Hero copy -->
    <section class="mt-6">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
        Who <span class="text-indigo-600 dark:text-indigo-400">actually</span> delivers the most rupiah?
      </h2>
      <p class="mt-1 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
        Upfront fees are only half the story. We add the hidden exchange-rate markup back in —
        using each provider's <strong class="font-semibold text-slate-800 dark:text-slate-200">own quoted rate</strong>
        where we can fetch it live — so you compare the <strong class="font-semibold text-slate-800 dark:text-slate-200">real payout</strong>
        your recipient gets.
      </p>
    </section>

    <!-- Control panel: one input, one button (IDR corridor is fixed) -->
    <form
      id="compare-form"
      class="mt-6 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:flex-row sm:items-end sm:p-6"
    >
      <div class="flex-1">
        <label for="amount" class="mb-1.5 block text-sm font-medium">You send (JPY)</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-lg font-semibold text-slate-400">¥</span>
          <input
            id="amount"
            name="amount"
            type="number"
            inputmode="numeric"
            min={MIN_AMOUNT_JPY}
            max={MAX_AMOUNT_JPY}
            value={DEFAULT_AMOUNT_JPY}
            class="w-full rounded-xl border border-slate-300 bg-slate-50 py-3 pl-9 pr-4 text-lg font-semibold tabular-nums outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 dark:border-slate-700 dark:bg-slate-950"
          />
        </div>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400" id="rate-line">{rateLineHtml}</p>
      </div>
      <button
        id="compare-btn"
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-60"
      >
        <span data-label>Compare</span>
      </button>
    </form>

    <!-- Results header -->
    <section class="mt-8 flex items-end justify-between gap-4">
      <div>
        <h3 class="text-lg font-semibold">Comparison — Japan → Indonesia</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400" id="results-meta">{resultsMetaHtml}</p>
      </div>
    </section>

    <!-- Server-rendered comparison table (re-rendered client-side on Compare) -->
    <section id="results" class="mt-4" aria-live="polite" set:html={renderResultsTable(initial)} />

    <noscript>
      <p class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800">
        The comparison above is live server-rendered data. JavaScript is only needed to re-run it
        with a different amount — you can also query
        <code>/api/simulate?amountJPY=100000&amp;targetCurrency=IDR</code> directly.
      </p>
    </noscript>

    <footer class="mt-12 border-t border-slate-200 pt-6 text-xs text-slate-400 dark:border-slate-800">
      <p>
        Providers marked <strong>Observed</strong> are quoted at their own live rates (timestamp on
        each row; cached for 12 hours) — everything else is an <strong>estimate</strong> from modeled
        markups. Mid-market reference rates via open.er-api.com. Upfront fees are illustrative
        except where noted; always confirm on the provider's site before sending.
      </p>
    </footer>
  </div>

  <!-- Bootstrap data for the client controller -->
  <script is:inline type="application/json" id="bootstrap-data" set:html={JSON.stringify(bootstrap)}></script>

  <script src="../scripts/simulator.ts"></script>
</Layout>
